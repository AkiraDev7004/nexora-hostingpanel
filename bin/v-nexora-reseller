#!/bin/bash
# info: NEXORA roles + reseller customers
# options: ACTION ...
#   set-role USER user|reseller|admin [PACKAGES]   (admin only via panel; PACKAGES comma list allowed for reseller)
#   role USER                                      print role
#   add-customer RESELLER USER PASSWORD EMAIL PACKAGE [NAME]
#   customers RESELLER [json]
#   suspend|unsuspend|delete RESELLER CUSTOMER
# Ownership is checked here (server side) for every reseller action.
source /etc/hestiacp/hestia.conf
source $HESTIA/func/main.sh
source_conf "$HESTIA/conf/hestia.conf"
fail() {
	echo "Error: $1" >&2
	exit "${2:-$E_INVALID}"
}
rf() { echo "$HESTIA/data/users/$1/nexora-role"; }
uok() { [[ "$1" =~ ^[a-z][a-z0-9_-]{1,30}$ ]] && [ -d "$HESTIA/data/users/$1" ] || fail "invalid user $1" "$E_NOTEXIST"; }
role() {
	local ROLE=user
	[ -f "$(rf "$1")" ] && source "$(rf "$1")"
	[ "$1" = "$ROOT_USER" ] || [ "$1" = admin ] && ROLE=admin
	echo "$ROLE"
}
parent() {
	local PARENT=""
	[ -f "$(rf "$1")" ] && source "$(rf "$1")"
	echo "$PARENT"
}
need_reseller() {
	uok "$1"
	[ "$(role "$1")" = reseller ] || fail "$1 is not a reseller" "$E_FORBIDEN"
}
owns() {
	uok "$2"
	[ "$(parent "$2")" = "$1" ] || fail "customer does not belong to reseller" "$E_FORBIDEN"
}
case "$1" in
	set-role)
		uok "$2"
		[[ "$3" =~ ^(user|reseller|admin)$ ]] || fail "invalid role"
		[ -z "$4" ] || [[ "$4" =~ ^[A-Za-z0-9_,-]+$ ]] || fail "invalid packages"
		p=$(parent "$2")
		printf "ROLE='%s'\nPARENT='%s'\nPACKAGES='%s'\n" "$3" "$p" "$4" > "$(rf "$2")"
		[ "$3" = admin ] && usermod -aG admin "$2" 2> /dev/null
		;;
	role)
		uok "$2"
		role "$2"
		exit 0
		;;
	add-customer)
		need_reseller "$2"
		PACKAGES=""
		source "$(rf "$2")"
		[[ ",$PACKAGES," == *",$6,"* ]] || fail "package not allowed for this reseller" "$E_FORBIDEN"
		$BIN/v-add-user "$3" "$4" "$5" "$6" "${7:-$3}" || exit $?
		printf "ROLE='user'\nPARENT='%s'\nPACKAGES=''\n" "$2" > "$(rf "$3")"
		;;
	customers)
		uok "$2"
		first=1
		[ "$3" = json ] && printf '{'
		for f in $HESTIA/data/users/*/nexora-role; do
			[ -f "$f" ] || continue
			u=$(basename "$(dirname "$f")")
			[ "$(parent "$u")" = "$2" ] || continue
			(
				source "$HESTIA/data/users/$u/user.conf"
				if [ "$3" = json ]; then
					[ $first = 1 ] || printf ','
					printf '"%s":{"NAME":"%s","EMAIL":"%s","PACKAGE":"%s","SUSPENDED":"%s","WEB":"%s","DISK":"%s"}' "$u" "$NAME" "$CONTACT" "$PACKAGE" "$SUSPENDED" "$U_WEB_DOMAINS" "$U_DISK"
				else echo "$u $PACKAGE $SUSPENDED"; fi
			)
			first=0
		done
		[ "$3" = json ] && echo '}'
		exit 0
		;;
	suspend)
		need_reseller "$2"
		owns "$2" "$3"
		$BIN/v-suspend-user "$3" yes
		;;
	unsuspend)
		need_reseller "$2"
		owns "$2" "$3"
		$BIN/v-unsuspend-user "$3" yes
		;;
	delete)
		need_reseller "$2"
		owns "$2" "$3"
		$BIN/v-delete-user "$3" && rm -f "$(rf "$3")"
		;;
	*) fail "unknown action" ;;
esac
log_event "$OK" "$(echo "$ARGUMENTS" | sed -E 's/^(add-customer [^ ]+ [^ ]+ )[^ ]+/\1*****/')"
exit 0
