#!/bin/bash
# info: NEXORA DNS blocking / overrides / blocklists for the recursive resolver (Unbound)
# options: ACTION [ARG...]
#
#   add-block   DOMAIN [nxdomain|null|sinkhole] [SINKHOLE_IPV4] [SINKHOLE_IPV6] [exact|sub|all]
#               exact = only DOMAIN, sub = only its subdomains, all = DOMAIN + subdomains (default)
#               "*.example.com" is a shortcut for scope sub
#   del-block   DOMAIN
#   add-redirect DOMAIN TYPE(A|AAAA|CNAME) TARGET [TTL] [exact|sub|all]   (DNS override, not HTTP)
#   del-redirect DOMAIN
#   add-list    NAME URL          (https only, public hosts only - SSRF protection)
#   update-list NAME | del-list NAME | toggle-list NAME
#   list        [json]            rules
#   lists       [json]            blocklists
#   resolver    LISTEN_IP[@PORT] [ALLOWED_CIDR,...]   configure + enable resolver
#   apply       regenerate unbound config and reload
#
# Authoritative DNS (BIND/Hestia zones) stays non-recursive. Blocking only
# applies to the separate resolver, which only answers ALLOWED_CIDR clients.

source /etc/hestiacp/hestia.conf
source $HESTIA/func/main.sh
source_conf "$HESTIA/conf/hestia.conf"
set -f # names like *.example.com must never glob

D="$HESTIA/data/nexora/dns"
RULES="$D/rules" # TYPE|DOMAIN|MODE|VALUE|TTL
LISTS="$D/lists" # NAME|URL|ENABLED|COUNT|UPDATED
OUT=/etc/unbound/unbound.conf.d/nexora.conf
mkdir -p "$D/lists.d" && touch "$RULES" "$LISTS" && chmod 750 "$D"

fail() {
	echo "Error: $1" >&2
	exit "${2:-$E_INVALID}"
}
dom_ok() { [[ "$1" =~ ^(\*\.)?([A-Za-z0-9_]([A-Za-z0-9_-]{0,61}[A-Za-z0-9_])?\.)+[A-Za-z]{2,63}$ ]]; }
v4_ok() { [[ "$1" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]]; }
v6_ok() { [[ "$1" =~ ^[0-9A-Fa-f:]+$ && "$1" == *:* ]]; }
name_ok() { [[ "$1" =~ ^[A-Za-z0-9_-]{1,40}$ ]]; }
del_rule() {
	grep -v "^[A-Z]*|$1|" "$RULES" > "$RULES.tmp"
	mv "$RULES.tmp" "$RULES"
}

# Refuse URLs that resolve to private/loopback/link-local ranges (SSRF)
url_safe() {
	local url=$1 host ip
	[[ "$url" =~ ^https://([A-Za-z0-9.-]+)(:[0-9]+)?(/[^[:space:]]*)?$ ]] || return 1
	host=${BASH_REMATCH[1]}
	for ip in $(getent ahosts "$host" | awk '{print $1}' | sort -u); do
		[[ "$ip" =~ ^(10\.|127\.|0\.|169\.254\.|192\.168\.|172\.(1[6-9]|2[0-9]|3[01])\.|100\.(6[4-9]|[7-9][0-9]|1[01][0-9]|12[0-7])\.) ]] && return 1
		[[ "$ip" =~ ^(::1|fe80:|fc|fd|::ffff:) ]] && return 1
	done
	[ -n "$ip" ]
}

fetch_list() {
	local name=$1 url=$2 tmp
	url_safe "$url" || fail "URL rejected (https + public host only)"
	tmp=$(mktemp)
	curl -fsS --proto =https --max-redirs 0 --max-time 60 --max-filesize 52428800 "$url" -o "$tmp" || {
		rm -f "$tmp"
		fail "download failed"
	}
	# hosts files ("0.0.0.0 domain") and plain domain lists; dedupe; validate
	sed -e 's/#.*//' -e 's/\r//' "$tmp" | awk '{d=(NF>=2)?$2:$1; print tolower(d)}' \
		| grep -E '^([a-z0-9_]([a-z0-9_-]{0,61}[a-z0-9_])?\.)+[a-z]{2,63}$' \
		| grep -vxE 'localhost|localhost\.localdomain|local' | sort -u > "$D/lists.d/$name"
	rm -f "$tmp"
	wc -l < "$D/lists.d/$name"
}

# Blocking uses an RPZ (response policy zone) loaded by Unbound. RPZ distinguishes
# "name" (exact) from "*.name" (all subdomains), so the scopes below are exact.
#   scope exact = only DOMAIN    scope sub = only subdomains    scope all = both
RPZ=/var/lib/unbound/nexora.rpz
rpz_names() { # DOMAIN SCOPE
	case "$2" in exact) echo "$1" ;; sub) echo "*.$1" ;; *)
		echo "$1"
		echo "*.$1"
		;;
	esac
}
apply() {
	[ -d /etc/unbound/unbound.conf.d ] || fail "Unbound resolver not installed" "$E_NOTEXIST"
	local tmp ztmp n
	tmp=$(mktemp)
	ztmp=$(mktemp)
	{
		echo '$TTL 300'
		echo "@ SOA localhost. hostmaster.localhost. $(date +%s) 3600 600 86400 300"
		echo "@ NS localhost."
		while IFS='|' read -r t dom mode val ttl scope; do
			[ -z "$t" ] && continue
			for n in $(rpz_names "$dom" "${scope:-all}"); do
				if [ "$t" = BLOCK ]; then
					case "$mode" in
						nxdomain) echo "$n CNAME ." ;;
						null)
							echo "$n 60 A 0.0.0.0"
							echo "$n 60 AAAA ::"
							;;
						sinkhole)
							v4=${val%%,*} v6=${val#*,}
							[ -n "$v4" ] && echo "$n 60 A $v4"
							[ -n "$v6" ] && echo "$n 60 AAAA $v6"
							;;
					esac
				else
					echo "$n ${ttl:-300} $mode $val"
				fi
			done
		done < "$RULES"
		while IFS='|' read -r ln u en c up; do
			[ "$en" = yes ] && [ -f "$D/lists.d/$ln" ] && awk '{print $1" CNAME ."; print "*."$1" CNAME ."}' "$D/lists.d/$ln"
		done < "$LISTS"
	} | awk '!seen[$0]++' > "$ztmp"
	{
		echo "# Generated by NEXORA - do not edit"
		echo "server:"
		echo '  module-config: "respip validator iterator"'
		[ -f "$D/resolver" ] && cat "$D/resolver"
		echo "rpz:"
		echo "  name: nexora.rpz."
		echo "  zonefile: $RPZ"
		echo "  rpz-log: yes"
		echo "  rpz-log-name: nexora"
	} > "$tmp"
	mkdir -p "$(dirname "$RPZ")"
	[ -f "$RPZ" ] && cp "$RPZ" "$RPZ.bak"
	[ -f "$OUT" ] && cp "$OUT" "$OUT.bak"
	install -m 644 "$ztmp" "$RPZ"
	install -m 644 "$tmp" "$OUT"
	rm -f "$tmp" "$ztmp"
	if ! unbound-checkconf > /dev/null; then
		[ -f "$OUT.bak" ] && mv "$OUT.bak" "$OUT" || rm -f "$OUT"
		[ -f "$RPZ.bak" ] && mv "$RPZ.bak" "$RPZ"
		fail "generated config invalid - reverted"
	fi
	systemctl reload-or-restart unbound
}

scope_of() { # sets dom + scope from INPUT [SCOPE]
	dom=${1,,}
	scope=${2:-all}
	[[ "$dom" == \*.* ]] && {
		dom=${dom#\*.}
		scope=sub
	}
	[[ "$scope" =~ ^(exact|sub|all)$ ]] || fail "scope must be exact|sub|all"
}

case "$1" in
	add-block)
		dom_ok "$2" || fail "invalid domain"
		mode=${3-nxdomain}
		case "$mode" in nxdomain | null) val="" ;; sinkhole)
			v4_ok "$4" || [ -z "$4" ] || fail "invalid IPv4"
			v6_ok "$5" || [ -z "$5" ] || fail "invalid IPv6"
			[ -n "$4$5" ] || fail "sinkhole IP required"
			val="$4,$5"
			;;
		*) fail "invalid mode" ;; esac
		scope_of "$2" "$6"
		del_rule "$dom"
		echo "BLOCK|$dom|$mode|$val||$scope" >> "$RULES"
		apply
		;;
	del-block | del-redirect)
		scope_of "$2"
		del_rule "$dom"
		apply
		;;
	add-redirect)
		dom_ok "$2" || fail "invalid domain"
		case "$3" in A) v4_ok "$4" ;; AAAA) v6_ok "$4" ;; CNAME) dom_ok "$4" ;; *) false ;; esac || fail "invalid target"
		ttl=${5-300}
		[[ "$ttl" =~ ^[0-9]+$ ]] || fail "invalid ttl"
		tgt=$4
		[ "$3" = CNAME ] && tgt="${4%.}."
		scope_of "$2" "$6"
		del_rule "$dom"
		echo "REDIRECT|$dom|$3|$tgt|$ttl|$scope" >> "$RULES"
		apply
		;;
	add-list)
		name_ok "$2" || fail "invalid name"
		grep -q "^$2|" "$LISTS" && fail "list exists" "$E_EXISTS"
		c=$(fetch_list "$2" "$3") || exit $?
		echo "$2|$3|yes|$c|$(date '+%F %T')" >> "$LISTS"
		apply
		;;
	update-list)
		name_ok "$2" || fail "invalid name"
		line=$(grep "^$2|" "$LISTS") || fail "no such list" "$E_NOTEXIST"
		IFS='|' read -r n u en c up <<< "$line"
		c=$(fetch_list "$n" "$u") || exit $?
		sed -i "/^$n|/d" "$LISTS"
		echo "$n|$u|$en|$c|$(date '+%F %T')" >> "$LISTS"
		apply
		;;
	toggle-list)
		name_ok "$2" || fail "invalid name"
		line=$(grep "^$2|" "$LISTS") || fail "no such list" "$E_NOTEXIST"
		IFS='|' read -r n u en c up <<< "$line"
		en=$([ "$en" = yes ] && echo no || echo yes)
		sed -i "/^$n|/d" "$LISTS"
		echo "$n|$u|$en|$c|$up" >> "$LISTS"
		apply
		;;
	del-list)
		name_ok "$2" || fail "invalid name"
		sed -i "/^$2|/d" "$LISTS"
		rm -f "$D/lists.d/$2"
		apply
		;;
	resolver)
		l=${2%@*} p=53
		[[ "$2" == *@* ]] && p=${2#*@}
		{ v4_ok "$l" || v6_ok "$l"; } && [[ "$p" =~ ^[0-9]+$ ]] || fail "invalid listen address"
		allow=${3-127.0.0.0/8}
		{
			echo "  interface: $l@$p"
			echo "  access-control: 0.0.0.0/0 refuse"
			echo "  access-control: ::/0 refuse"
			for c in ${allow//,/ }; do
				[[ "$c" =~ ^[0-9A-Fa-f.:]+/[0-9]{1,3}$ ]] || fail "invalid CIDR $c"
				echo "  access-control: $c allow"
			done
			echo "  hide-identity: yes"
			echo "  hide-version: yes"
			echo "  ratelimit: 1000"
		} > "$D/resolver"
		apply
		;;
	list)
		if [ "$2" = json ]; then
			awk -F'|' 'BEGIN{printf "["} {printf "%s{\"TYPE\":\"%s\",\"DOMAIN\":\"%s\",\"MODE\":\"%s\",\"VALUE\":\"%s\",\"TTL\":\"%s\",\"SCOPE\":\"%s\"}",(NR>1?",":""),$1,$2,$3,$4,$5,($6==""?"all":$6)} END{print "]"}' "$RULES"
		else cat "$RULES"; fi
		;;
	lists)
		if [ "$2" = json ]; then
			awk -F'|' 'BEGIN{printf "["} {printf "%s{\"NAME\":\"%s\",\"URL\":\"%s\",\"ENABLED\":\"%s\",\"COUNT\":\"%s\",\"UPDATED\":\"%s\"}",(NR>1?",":""),$1,$2,$3,$4,$5} END{print "]"}' "$LISTS"
		else cat "$LISTS"; fi
		;;
	apply) apply ;;
	*) fail "unknown action" ;;
esac
log_event "$OK" "$ARGUMENTS"
exit 0
